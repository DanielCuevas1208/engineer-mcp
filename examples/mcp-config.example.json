{
  "mcpServers": {
    "engineer-mcp": {
      "command": "node",
      "args": [
        "/absolute/path/to/engineer-mcp/dist/index.js",
        "--db",
        "/absolute/path/to/engineer-mcp/engineer-mcp.sqlite"
      ]
    },
    "engineer-mcp-http": {
      "url": "http://127.0.0.1:3000/mcp"
    }
  }
}
